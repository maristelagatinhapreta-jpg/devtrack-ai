name: Verificar projeto estático

on:
  push:
    branches: ["main"]
  pull_request:

jobs:
  validar:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout do código
        uses: actions/checkout@v4

      - name: Verificar arquivo principal
        run: |
          test -f index.html
          echo "index.html encontrado"

      - name: Verificar HTML básico
        run: |
          grep -q "<html" index.html
          echo "HTML válido"

      - name: Iniciar servidor local
        run: |
          python3 -m http.server 8000 &
          sleep 3

      - name: Validar resposta HTTP
        run: curl -I http://localhost:8000/index.html
